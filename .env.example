# Disaster Healthcare AI - API Environment Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8501"]
LOG_LEVEL=INFO

# Canonical JWT Secret Key (required in production; default permitted only in development)
JWT_SECRET_KEY=dev-secret-key-change-in-production-disaster-ai-2025

# Supported legacy alias:
# JWT_SECRET=dev-secret-key-change-in-production-disaster-ai-2025

# Legacy secret fallback:
SECRET_KEY=change-this-in-production-disaster-healthcare-ai-secret

# Administrator credentials (required in production)
ADMIN_PASSWORD=

ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=sqlite:///./disaster_healthcare.db
