# ================================
# Python environment & caches
# ================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# ================================
# Environment / secrets
# ================================
.env
.env.*
!.env.example

# ================================
# Frontend
# ================================
frontend/node_modules/
frontend/dist/
frontend/node_modules/.vite/
.vite/

# ================================
# Large raw datasets
# ================================
data/raw/*.zip
data/raw/*.tif
data/raw/*.xlsx

# ================================
# Intermediate/generated data
# ================================
data/interim/*
!data/interim/.gitkeep

# Keep processed data if intentionally versioned
!data/processed/.gitkeep

# ================================
# ML model artifacts
# ================================
models/*.joblib
!models/.gitkeep

# ================================
# Databases
# ================================
*.db
*.sqlite
*.sqlite3

# ================================
# Logs / temporary files
# ================================
*.log
scratch/
reports/test_report.*
reports/*.pdf